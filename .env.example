# Optional. Copy to .env (git-ignored) and fill in to enable the Adzuna aggregator.
# Free keys: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# TinyFish (Wellfound + YC Work at a Startup discovery). Free key: https://agent.tinyfish.ai
TINYFISH_API_KEY=
# Private repo that receives the daily GitHub-Actions job feed (see README -> "Run the crawl on GitHub Actions")
FEED_REPO_URL=
# Override the resume location if it isn't ~/Downloads/new_resume.pdf
# JOBS_RESUME=/path/to/resume.pdf
# The name shown in the navbar and page titles (default: Foothold). Letters, digits, spaces and . & + ' - only.
APP_NAME=
